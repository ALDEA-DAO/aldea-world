{
  "name": "aldea-world",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "mprocs",
    "dev:client": "pnpm --filter client dev",
    "dev:contracts": "pnpm --filter contracts dev",
    "foundry:up": "curl -L https://foundry.paradigm.xyz | bash && bash $HOME/.foundry/bin/foundryup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:lite": "mprocs --config mprocs.lite.yaml",
    "dev:deploy": "scripts/dev-deploy.sh",
    "dev:health": "scripts/dev-health.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@latticexyz/store-indexer": "2.2.23",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "mprocs": "^0.7.3",
    "prettier": "3.2.5",
    "prettier-plugin-solidity": "1.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": "^9"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
