# Effectstream reads its own database variables (not DATABASE_URL). The node owns the `effectstream` database:
# its internal tables live in a schema literally named `effectstream` and the read model in `public`.
DB_HOST=localhost
DB_PORT=5442
DB_USER=aldea
DB_PW=aldea
DB_NAME=effectstream
# Local development without Docker: PGLITE=true and the PGlite server (see SPIKE.md)
PGLITE=false
# Effectstream needs the pg_ivm extension (PGlite bundles it). Only for local Postgres without it:
ALLOW_NO_PG_IVM=false
EFFECTSTREAM_API_PORT=9999
# Embedded MQTT broker: TCP 8883, WebSocket 9883 (browsers)
MQTT_BROKER=true
MQTT_ENGINE_BROKER_PORT=8883
MQTT_ENGINE_BROKER_WS_PORT=9883

CHAIN_ID=31337
BASE_RPC_URL=http://127.0.0.1:8545
BASE_CONFIRMATIONS=
# Defaults to packages/shared/src/deployments/<CHAIN_ID>.json
START_BLOCK=
SYSTEM_ADDRESSES_JSON=
# Main clock start (unix ms) for a fresh database; restarts recover it from the database
EFFECTSTREAM_GENESIS_MS=
WORLD_ADDRESS=
ALMA_REGISTRY_ADDRESS=
ATLAS_ADDRESS=
# The Council: AldeaCouncilExecutor, the CouncilInputs contract and the guardian that posts each proposal's rules
COUNCIL_ADDRESS=
COUNCIL_INPUTS_ADDRESS=
COUNCIL_OPERATOR_ADDRESS=
# $ALDEA on Cardano over UTxO RPC. Empty: the node runs without Cardano. Local Dolos (scripts/cardano/dolos.sh up):
# http://localhost:50051. A hosted endpoint (Demeter) also needs its API key.
CARDANO_UTXORPC_URL=
CARDANO_UTXORPC_API_KEY=
# preprod (tALDEA) or mainnet; the asset defaults to packages/shared/src/constants.ts for that network
CARDANO_NETWORK=preprod
ALDEA_POLICY_ID=
ALDEA_ASSET_NAME_HEX=
# A block just before the asset's first UTxO (preprod has a default; mainnet needs both)
CARDANO_START_SLOT=
CARDANO_START_HASH=
API_KEY_OPEN_ENDPOINTS_EXPLORER=
# The vote batcher (`pnpm batcher`): pays the gas of the votes it publishes in CouncilInputs
BATCHER_PRIVATE_KEY=
BATCHER_PORT=3334
# Error reports (Sentry), with the git commit as the release. Empty: none are sent
SENTRY_DSN=
GIT_COMMIT=
