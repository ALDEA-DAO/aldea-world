# Pays gas, and is the only account that may queue a Council result (the executor's relayer). Minimal funds on Base;
# rotated every 90 days (the guardian sets the new relayer on the executor).
# Without it (or without DATABASE_URL and a deployed World) only /health is served.
RELAYER_PRIVATE_KEY=
BASE_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Defaults to packages/shared/src/deployments/<CHAIN_ID>.json
WORLD_ADDRESS=
# AldeaCouncilExecutor; without it the Council jobs do not run
COUNCIL_ADDRESS=
# Effectstream's database (relay_outbox). The role should be read-only except for INSERT on relay_attempts.
DATABASE_URL=postgres://aldea:aldea@localhost:5442/effectstream
POLL_MS=2000
PORT=8788
# Where the relay reads a Council tally before queueing it
EFFECTSTREAM_API_URL=http://localhost:9999
# The tally's public address, published on-chain when it is not pinned (defaults to EFFECTSTREAM_API_URL)
EFFECTSTREAM_PUBLIC_URL=
# Pins the tally to IPFS; without it the tallyURI is the read model's address above
PINATA_JWT=
SENTRY_DSN=
