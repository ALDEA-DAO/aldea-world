# Pays gas for permissionless calls only (no role); minimal funds on Base; rotated every 90 days.
# Without it (or without DATABASE_URL and a deployed World) only /health is served.
RELAYER_PRIVATE_KEY=
BASE_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Defaults to packages/shared/src/deployments/<CHAIN_ID>.json
WORLD_ADDRESS=
# Effectstream's database (relay_outbox). The role should be read-only except for INSERT on relay_attempts.
DATABASE_URL=postgres://aldea:aldea@localhost:5442/effectstream
POLL_MS=2000
PORT=8788
EFFECTSTREAM_API_URL=http://localhost:9999
# To publish the Charter tally
PINATA_JWT=
SENTRY_DSN=
