PORT=8787
DATABASE_URL=postgres://aldea:aldea@localhost:5442/aldea
# ALMA Auth (the OIDC provider behind Sign in with ALMA)
ALMA_AUTH_ISSUER=http://localhost:8787
# Audience of ALMA Auth access tokens (this API)
ALMA_API_RESOURCE=http://localhost:8787/v1
# ES256 signing keys as a private JWKS, signing key first (`pnpm --filter @aldea/alma-resolver auth:keygen`).
# Empty locally: an ephemeral key is generated. Required in production (secret manager).
ALMA_AUTH_JWKS=
# Comma-separated cookie-signing keys and the pairwise-subject salt (required in production)
ALMA_AUTH_COOKIE_KEYS=
ALMA_AUTH_PAIRWISE_SALT=
# OIDC clients to register with `db:clients` (JSON array); empty locally: aldea-world on http://localhost:3000
ALMA_AUTH_CLIENTS=
WEBAUTHN_RP_ID=localhost
# Emails are stored only as HMAC(email)
EMAIL_HMAC_KEY=
RESEND_API_KEY=
# Sender of the email codes (a domain verified in Resend)
RESEND_FROM=ALMA <login@adasouls.io>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY=
# Turnkey parent organization (creates each soul's sub-organization)
TURNKEY_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_BASE_URL=https://api.turnkey.com
# OIDC client whose ID tokens log souls in to Turnkey
TURNKEY_OIDC_AUDIENCE=aldea-world
ALMA_NETWORK=main
BASE_RPC_URL=http://127.0.0.1:8545
BASE_CHAIN_ID=31337
ALMA_REGISTRY_ADDRESS=
WORLD_ADDRESS=
# CDP bundler + paymaster (Base Sepolia / Base; it embeds the API key). Empty locally: anvil has no bundler
CDP_PAYMASTER_URL=
# In a secret manager; rotatable via Config.founderAttestor
FOUNDER_ATTESTOR_PRIVATE_KEY=
EFFECTSTREAM_API_URL=http://localhost:9999
CORS_ORIGINS=http://localhost:3000
# Empty locally
SENTRY_DSN=
