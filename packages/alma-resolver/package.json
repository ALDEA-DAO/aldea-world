{
  "name": "@aldea/alma-resolver",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ALMA Resolver: ALMA documents, Sign in with ALMA sessions and Founder attestations (Hono + Drizzle).",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@adasouls/alma-core": "^0.3.0",
    "@aldea/shared": "workspace:^",
    "@hono/node-server": "^2.1.1",
