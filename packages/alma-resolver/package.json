{
  "name": "@aldea/alma-resolver",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ALMA Resolver: ALMA documents, Sign in with ALMA sessions and Founder attestations (Hono + Drizzle).",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "smoke:custody": "tsx --env-file=.env.staging scripts/smoke-custody.ts",
    "db:clients": "tsx src/db/clients.ts",
    "auth:keygen": "tsx scripts/auth-keygen.ts",
    "seed": "tsx src/seed/orgs.ts"
  },
  "dependencies": {
    "@adasouls/alma-core": "^0.3.0",
    "@aldea/shared": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^11.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@turnkey/sdk-server": "8.6.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@turnkey/api-key-stamper": "0.6.17",
    "@turnkey/crypto": "2.13.2",
    "@turnkey/viem": "0.14.43",
    "@types/oidc-provider": "^9.12.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ALDEA-DAO/aldea-world.git",
    "directory": "packages/alma-resolver"
  }
}
