    "@sentry/node": "^11.0.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ALDEA-DAO/aldea-world.git",
    "directory": "packages/alma-resolver"
