{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "mud build",
    "clean": "forge clean && shx rm -rf src/**/codegen",
    "deploy:base": "mud deploy --profile=base --rpc ${BASE_RPC_URL:-https://mainnet.base.org}",
    "deploy:base-sepolia": "mud deploy --profile=base-sepolia --rpc ${BASE_SEPOLIA_RPC_URL:-https://sepolia.base.org}",
    "deploy:local": "mud deploy",
    "dev": "mud dev-contracts",
    "lint": "pnpm run prettier && pnpm run solhint",
    "prettier": "prettier --write 'src/**/*.sol'",
    "solhint": "solhint --config ./.solhint.json 'src/**/*.sol' --fix",
    "test": "mud test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@latticexyz/cli": "2.2.23",
    "@latticexyz/schema-type": "2.2.23",
    "@latticexyz/store": "2.2.23",
    "@latticexyz/world": "2.2.23",
    "@latticexyz/world-modules": "2.2.23",
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "forge-std": "github:foundry-rs/forge-std#ba4733c33497dd0c0983dcc033d7645576cc46e5",
    "prettier": "3.2.5",
    "prettier-plugin-solidity": "1.3.1",
    "shx": "^0.3.4",
    "solhint": "^3.3.7",
    "solhint-config-mud": "2.2.23",
    "solhint-plugin-mud": "2.2.23"
  }
}
