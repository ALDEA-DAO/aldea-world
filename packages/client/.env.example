# Chain: 31337 (anvil), 84532 (Base Sepolia) or 8453 (Base)
VITE_CHAIN_ID=31337
# Contract addresses (defaults come from packages/shared/src/deployments/<chainId>.json)
VITE_WORLD_ADDRESS=
VITE_ALMA_REGISTRY_ADDRESS=
VITE_ATLAS_ADDRESS=
VITE_COUNCIL_ADDRESS=
# bytes32 of the ALDEA world in the Atlas
VITE_ALDEA_WORLD_ID=
# Sign in with ALMA (ALMA Auth OIDC) and custody (docs/decisions/0006-alma-auth-and-wallets.md)
VITE_ALMA_AUTH_ISSUER=https://auth.adasouls.io
VITE_ALMA_AUTH_CLIENT_ID=aldea-world
VITE_TURNKEY_ORG_ID=
VITE_CDP_BUNDLER_URL=
VITE_CDP_PAYMASTER_URL=
# eoa locally (anvil has no bundler), smart elsewhere
VITE_AA_MODE=eoa
# Services
VITE_ALMA_API_URL=http://localhost:8787
VITE_EFFECTSTREAM_API_URL=http://localhost:9999
VITE_EFFECTSTREAM_MQTT_URL=ws://localhost:9883
VITE_MUD_INDEXER_URL=http://localhost:3001
# Injected by CI
VITE_BUILD_GIT_COMMIT=
VITE_BUILD_SEMVER=
