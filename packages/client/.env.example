# Chain: 31337 (anvil), 84532 (Base Sepolia) or 8453 (Base)
VITE_CHAIN_ID=31337
# Contract addresses (defaults come from packages/shared/src/deployments/<chainId>.json)
VITE_WORLD_ADDRESS=
VITE_ALMA_REGISTRY_ADDRESS=
VITE_ATLAS_ADDRESS=
VITE_COUNCIL_ADDRESS=
# bytes32 of this world in the Atlas (a fork sets its own)
VITE_ALDEA_WORLD_ID=
# A fork's name and palette (src/theme/worldConfig.ts; palettes in src/styles/themes): e.g. "ALDEA Nocturna" and nocturna
VITE_WORLD_NAME=
VITE_WORLD_THEME=
# Sign in with ALMA (ALMA Auth OIDC; https://auth.adasouls.io outside local development) and custody (Turnkey,
# Coinbase Smart Wallet). The redirect URI is this app's own page (e.g. http://localhost:3000/), registered in the
# Resolver with `db:clients`.
VITE_ALMA_AUTH_ISSUER=http://localhost:8787
VITE_ALMA_AUTH_CLIENT_ID=aldea-world
VITE_TURNKEY_API_URL=https://api.turnkey.com
# smart: Coinbase Smart Wallet with sponsored gas through the Resolver ({VITE_ALMA_API_URL}/v1/aa/rpc, which holds
# the CDP key); eoa: plain transactions from the owner key, funded by anvil (local only: anvil has no bundler)
VITE_AA_MODE=eoa
# Services
VITE_ALMA_API_URL=http://localhost:8787
VITE_EFFECTSTREAM_API_URL=http://localhost:9999
VITE_EFFECTSTREAM_MQTT_URL=ws://localhost:9883
VITE_MUD_INDEXER_URL=http://localhost:3001
# Injected by CI
VITE_BUILD_GIT_COMMIT=
VITE_BUILD_SEMVER=
