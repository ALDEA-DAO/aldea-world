        "inputs": [
          { "name": "almaRegistry", "type": "address", "internalType": "address" },
          { "name": "founderAttestor", "type": "address", "internalType": "address" },
          { "name": "minFounderBalance", "type": "uint128", "internalType": "uint128" },
          { "name": "genesisEndsAt", "type": "uint64", "internalType": "uint64" },
          { "name": "birthDelayBlocks", "type": "uint16", "internalType": "uint16" }
        ]
      },
      "contractInputsValues": {
        "almaRegistry": "<ALMA_ANCHOR_REGISTRY_ADDRESS>",
        "founderAttestor": "<FOUNDER_ATTESTOR_ADDRESS>",
